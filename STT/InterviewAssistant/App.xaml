<Application x:Class="InterviewAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Friendly, calm look: a rounded typeface, soft violet accent, pill buttons with a little
         "press" depth, rounded cards on soft shadows, and a few pastel colours for icons.
         ThemeManager swaps the colours for light and dark; these are the dark values. -->
    <Application.Resources>
        <!-- Surfaces, darkest to lightest -->
        <SolidColorBrush x:Key="WindowBg" Color="#15131F" />
        <SolidColorBrush x:Key="PanelBg" Color="#1C1A29" />
        <SolidColorBrush x:Key="Surface" Color="#242236" />
        <SolidColorBrush x:Key="InputBg" Color="#18162A" />
        <SolidColorBrush x:Key="TrackBg" Color="#121020" />
        <SolidColorBrush x:Key="HoverBg" Color="#2B2842" />
        <SolidColorBrush x:Key="PressedBg" Color="#353150" />
        <SolidColorBrush x:Key="Border" Color="#2E2B45" />
        <SolidColorBrush x:Key="BorderStrong" Color="#45405F" />

        <!-- Text -->
        <SolidColorBrush x:Key="Text" Color="#DEDBF0" />
        <SolidColorBrush x:Key="Strong" Color="#F7F5FF" />
        <SolidColorBrush x:Key="Muted" Color="#9C97B8" />
        <SolidColorBrush x:Key="Faint" Color="#6C6788" />

        <!-- Accent and status -->
        <SolidColorBrush x:Key="Accent" Color="#AA9EFF" />
        <SolidColorBrush x:Key="AccentDim" Color="#6C5CE7" />
        <SolidColorBrush x:Key="AccentBorder" Color="#4A3CC0" />
        <SolidColorBrush x:Key="AccentHover" Color="#7E70F2" />
        <SolidColorBrush x:Key="Highlight" Color="#C8BFFF" />
        <SolidColorBrush x:Key="PendingBg" Color="#29244E" />
        <SolidColorBrush x:Key="GradStart" Color="#8B7BFF" />
        <SolidColorBrush x:Key="GradEnd" Color="#5B5CE6" />
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B7BFF" Offset="0" />
            <GradientStop Color="#5B5CE6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Success" Color="#4ADE9B" />
        <SolidColorBrush x:Key="Danger" Color="#FF7A80" />
        <SolidColorBrush x:Key="ScrollThumb" Color="#3A3654" />
        <SolidColorBrush x:Key="ScrollThumbHover" Color="#544E72" />

        <!-- Pastel pairs (background, glyph) for icon chips -->
        <SolidColorBrush x:Key="LilacBg" Color="#2C2654" />
        <SolidColorBrush x:Key="LilacFg" Color="#B5AAFF" />
        <SolidColorBrush x:Key="MintBg" Color="#173A31" />
        <SolidColorBrush x:Key="MintFg" Color="#5FE0A9" />
        <SolidColorBrush x:Key="PeachBg" Color="#45291F" />
        <SolidColorBrush x:Key="PeachFg" Color="#FFA27E" />
        <SolidColorBrush x:Key="SkyBg" Color="#182D47" />
        <SolidColorBrush x:Key="SkyFg" Color="#7CBCFF" />
        <SolidColorBrush x:Key="SunBg" Color="#3D3318" />
        <SolidColorBrush x:Key="SunFg" Color="#FFD36B" />

        <!-- Nunito (SIL Open Font License, Assets/Fonts) with Segoe UI for any character it lacks -->
        <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Nunito, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Nunito, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
        <!-- Windows' own icon font (Windows 11; Windows 10 has the same glyphs in MDL2 Assets) -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Soft shadow for cards. Put it on an empty border behind the content: an effect on the
             content itself would blur its text. -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="22" ShadowDepth="3" Direction="270" Color="#2A1F66"
                          Opacity="0.10" RenderingBias="Quality" />
        <DropShadowEffect x:Key="LiftShadow" BlurRadius="10" ShadowDepth="1" Direction="270" Color="#2A1F66"
                          Opacity="0.14" RenderingBias="Quality" />

        <!-- Keyboard focus (Tab) only; a mouse click shows nothing -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource Accent}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons: pills with a thin "lip" underneath, so they look pressable. Quiet by default,
             the gradient one only for the main action on each screen. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,2"
                                    CornerRadius="16" SnapsToDevicePixels="True" />
                            <Border x:Name="Face" Padding="{TemplateBinding Padding}" Margin="1,1,1,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBg}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Bd" Property="Margin" Value="0,1,0,0" />
                                <Setter TargetName="Face" Property="Margin" Value="1,2,1,1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3"
                                    CornerRadius="16" SnapsToDevicePixels="True" />
                            <!-- Brightens the gradient on hover -->
                            <Border x:Name="Shine" Background="#FFFFFF" Opacity="0" CornerRadius="16" Margin="0,0,0,3" />
                            <Border x:Name="Face" Padding="{TemplateBinding Padding}" Margin="0,0,0,3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1" />
                                <Setter TargetName="Bd" Property="Margin" Value="0,2,0,0" />
                                <Setter TargetName="Shine" Property="Margin" Value="0,2,0,1" />
                                <Setter TargetName="Face" Property="Margin" Value="0,2,0,1" />
                                <Setter TargetName="Shine" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small buttons (Submit / Clear, Sign out, Load resume) -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- Borderless round button showing one icon glyph (always give it a ToolTip) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A rounded square holding one coloured icon glyph: set Background to a *Bg brush and the
             glyph's Foreground to the matching *Fg brush -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="SmallIconChip" TargetType="Border" BasedOn="{StaticResource IconChip}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="ChipGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SmallChipGlyph" TargetType="TextBlock" BasedOn="{StaticResource ChipGlyph}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- A white (or raised dark) rounded card on a soft shadow -->
        <Style x:Key="Card" TargetType="ContentControl">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Padding" Value="22,18,22,20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="18" Background="{TemplateBinding Background}" Effect="{StaticResource SoftShadow}" />
                            <Border CornerRadius="18" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings navigation item: icon glyph in Tag, label as Content. Background and BorderBrush
             carry the icon chip's colours (a *Bg and its *Fg brush). -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource LilacBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LilacFg}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SmallIconChip}" Width="30" Height="30" CornerRadius="10"
                                        Background="{TemplateBinding Background}">
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource SmallChipGlyph}" FontSize="14"
                                               Foreground="{TemplateBinding BorderBrush}" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PendingBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Strong}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control (RadioButtons inside a SegmentHost border): the chosen one is a raised pill -->
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TrackBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style x:Key="ProviderTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Lift" CornerRadius="15" Background="{DynamicResource Surface}"
                                    Effect="{StaticResource LiftShadow}" Visibility="Hidden" />
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="15" Padding="14,5">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Lift" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Strong}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small segmented tab for status lines (Answer | Chat page) -->
        <Style x:Key="MiniTab" TargetType="RadioButton" BasedOn="{StaticResource ProviderTab}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Lift" CornerRadius="11" Background="{DynamicResource Surface}"
                                    Effect="{StaticResource LiftShadow}" Visibility="Hidden" />
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="11" Padding="10,2">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Lift" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Strong}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Strong}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <!-- The text box applies its Padding to the text itself; a margin here would double it. -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same look as the text box -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Strong}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scrollbars: no arrows, a rounded thumb that brightens on hover -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{DynamicResource ScrollThumb}" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,3">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" Margin="3,2">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch (CheckBox): content on the left, pill switch on the right -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="44" Height="26" CornerRadius="13"
                                    Background="{DynamicResource BorderStrong}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#FFFFFF" HorizontalAlignment="Left"
                                         Margin="3,0" Effect="{StaticResource LiftShadow}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentGradient}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A selectable card (RadioButton): its bubble turns into a check mark when chosen -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1.5" CornerRadius="16" Padding="16,13">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource BorderStrong}" StrokeThickness="2" />
                                    <Ellipse x:Name="Fill" Fill="{DynamicResource AccentGradient}" Visibility="Collapsed" />
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PendingBg}" />
                                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim slider (overlay transparency): rounded rail, accent fill, round white thumb -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Dot" Width="15" Height="15" Fill="#FFFFFF"
                                 Stroke="{DynamicResource AccentDim}" StrokeThickness="2.5" Effect="{StaticResource LiftShadow}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" MinHeight="18" Background="Transparent">
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource BorderStrong}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{DynamicResource AccentGradient}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollPage}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1" CornerRadius="10" Padding="11,7" MaxWidth="420">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menus: rounded popup, rounded hover rows, ✓ marks set as icons in code -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1" CornerRadius="14" Padding="0,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="9,7" Margin="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                                           Foreground="{DynamicResource Faint}" FontSize="11.5" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PendingBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Strong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="14,5" Background="{DynamicResource Border}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource Border}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small labels for sections -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Rounded pill used for status chips -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TrackBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>

        <!-- A key combination shown like a keyboard key (e.g. the Send hotkey) -->
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1,1,1,2.5" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="7,1,7,1" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="TextElement.FontSize" Value="10.5" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}" />
        </Style>
    </Application.Resources>
</Application>
