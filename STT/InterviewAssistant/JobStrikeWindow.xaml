<Window x:Class="InterviewAssistant.JobStrikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load from JobStrike" Height="640" Width="720" MinWidth="520" MinHeight="420"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <!-- One application per row: company and title, then candidate, stage and date -->
        <Style x:Key="ApplicationItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="14" Padding="12,9" Margin="0,0,0,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PendingBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="24,20,24,10">
            <Border Style="{StaticResource IconChip}" Width="40" Height="40" CornerRadius="13" Background="{DynamicResource LilacBg}">
                <TextBlock Text="&#xE821;" Style="{StaticResource ChipGlyph}" FontSize="18" Foreground="{DynamicResource LilacFg}" />
            </Border>
            <StackPanel>
                <TextBlock Text="Load from JobStrike" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Strong}" />
                <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Pick the application you are interviewing for. Its company, job description and resume are filled into Settings for you to check." />
            </StackPanel>
        </DockPanel>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Padding="16,7" />
                    <Button x:Name="LoadButton" Content="Load" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"
                            Padding="22,7" IsEnabled="False" Click="OnLoadClick" />
                </StackPanel>
                <TextBlock x:Name="FooterText" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>

        <Grid Margin="24,8,24,16">
            <!-- Sign in (once; only the access key JobStrike returns is kept) -->
            <ContentControl x:Name="SignInPanel" Style="{StaticResource Card}" Margin="0,4,0,0" VerticalAlignment="Top"
                            Visibility="Collapsed">
                <StackPanel MaxWidth="420" HorizontalAlignment="Left" Width="420">
                    <TextBlock Text="Sign in to JobStrike" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Strong}" />
                    <TextBlock x:Name="SiteText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" />
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UserBox" />
                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordBox" KeyDown="OnPasswordKeyDown" />
                    <TextBlock x:Name="SignInError" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                    <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Padding="20,7" Click="OnSignInClick" />
                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Your password is not saved. JobStrike gives this app an access key, which is kept encrypted for your Windows account." />
                </StackPanel>
            </ContentControl>

            <!-- Applications -->
            <DockPanel x:Name="ListPanel" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SignedInText" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="Sign out" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnSignOutClick" />
                    </StackPanel>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterInterview" Content="Interview stages" GroupName="Filter"
                                         Style="{StaticResource ProviderTab}" Checked="OnFilterChecked"
                                         ToolTip="HR, Technical and Final" />
                            <RadioButton x:Name="FilterScreening" Content="Screening" GroupName="Filter"
                                         Style="{StaticResource ProviderTab}" Checked="OnFilterChecked" />
                            <RadioButton x:Name="FilterAll" Content="All" GroupName="Filter"
                                         Style="{StaticResource ProviderTab}" Checked="OnFilterChecked"
                                         ToolTip="Every application, newest first" />
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="36,8,12,8" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False"
                               Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="SearchHint" Text="Search company, job title or candidate" IsHitTestVisible="False"
                               Foreground="{DynamicResource Faint}" Margin="38,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <CheckBox x:Name="ProfileToggle" DockPanel.Dock="Bottom" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Also fill “My profile”" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Name, education, LinkedIn and location of this application's profile. Replaces what you wrote there." />
                    </StackPanel>
                </CheckBox>
                <Grid>
                    <ListBox x:Name="ApplicationList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ApplicationItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Company initials in a colour picked from the name -->
                                    <Border Width="36" Height="36" CornerRadius="12" Background="{Binding AvatarBrush, Mode=OneWay}"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Initials, Mode=OneWay}" Foreground="White" FontWeight="ExtraBold"
                                                   FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Company, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Strong}" />
                                            <Run Text="{Binding TitleSuffix, Mode=OneWay}" Foreground="{DynamicResource Text}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Details, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="9,2" Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Stage, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ListMessage" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="420" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
