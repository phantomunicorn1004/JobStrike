<Window x:Class="InterviewAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Interview Assistant" Height="900" Width="1440" MinWidth="320" MinHeight="260"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        Loaded="OnLoaded" Closing="OnClosing">
    <DockPanel>
        <!-- Toolbar (full view): preparing the session -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewChatButton" ToolTip="Open a fresh chat and send your call prompt (profile, company, job description, resume)"
                            Click="OnNewChatClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,1,8,0" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                            <TextBlock x:Name="NewChatText" Text="New chat + call prompt" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Listen / Stop: the text selected on the chat page, or else the latest answer -->
                    <Button x:Name="ToolbarListenButton" AutomationProperties.Name="Listen (toolbar)" Click="OnListenClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToolbarListenGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,8,0" Foreground="{DynamicResource Accent}" />
                            <TextBlock x:Name="ToolbarListenText" Text="Listen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Settings" Content="&#xE713;" Style="{StaticResource IconButton}" Width="34" Height="32" FontSize="16"
                            Margin="0,0,8,0" Click="OnSetupClick"
                            ToolTip="Settings: your details and call prompt, how Send works, display, hotkeys" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="0" Padding="18,7" Click="OnToggleCompactClick"
                            AutomationProperties.Name="Interview view"
                            ToolTip="Small window for the interview: live captions and the AI answer in large, clean text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Interview view" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                       Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/AppIcon.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Interview Assistant" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Strong}" VerticalAlignment="Center" Margin="10,0,0,1" />
                    <Border Width="1" Background="{DynamicResource Border}" Margin="16,6" />
                    <!-- Answers from an AI API: which one, and the model (Settings ▸ Answers) -->
                    <Border x:Name="EnginePill" Style="{StaticResource Pill}" Padding="10,4" VerticalAlignment="Center"
                            Visibility="Collapsed" ToolTip="Answers come straight from this AI service (Settings ▸ Answers)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="EngineText" FontSize="12" Foreground="{DynamicResource Text}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ProviderSwitch" Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ChatGptTab" Content="ChatGPT" GroupName="Provider"
                                         Style="{StaticResource ProviderTab}" Checked="OnProviderChecked" />
                            <RadioButton x:Name="DeepSeekTab" Content="DeepSeek" GroupName="Provider"
                                         Style="{StaticResource ProviderTab}" Checked="OnProviderChecked" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar (full view) -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="HotkeyHint" DockPanel.Dock="Right" Foreground="{DynamicResource Faint}"
                           FontSize="11.5" Margin="16,0,0,0" Cursor="Help" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="10,1" Margin="16,0,0,0"
                        Background="{DynamicResource PendingBg}" BorderBrush="Transparent">
                    <TextBlock x:Name="ModeText" Foreground="{DynamicResource Accent}" FontSize="11.5" />
                </Border>
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis" Text="Starting…" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Rows and columns are built in code for the chosen caption position (MainWindow.PlaceCaptions). -->
        <Grid x:Name="LayoutRoot">
            <!-- Captions: docked beside the chat, or moved into a separate window -->
            <Grid x:Name="CaptionPanel" Background="{DynamicResource PanelBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel x:Name="CaptionHeader" Margin="16,12,12,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="Clear captions" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                FontSize="13" Click="OnClearCaptionsClick"
                                ToolTip="Clear the caption history (New chat does this too)" />
                        <Button AutomationProperties.Name="Smaller caption text" Content="A−" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontSize="12.5" Click="OnFontSmaller" ToolTip="Smaller caption text" />
                        <Button AutomationProperties.Name="Larger caption text" Content="A+" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontSize="12.5" Margin="0" Click="OnFontLarger" ToolTip="Larger caption text" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip="Tip: in Live Captions settings turn OFF 'Include microphone audio' so only the interviewer is captured.">
                        <Border Style="{StaticResource SmallIconChip}" Background="{DynamicResource MintBg}">
                            <TextBlock Text="&#xE720;" Style="{StaticResource SmallChipGlyph}" Foreground="{DynamicResource MintFg}" />
                        </Border>
                        <TextBlock Text="Live captions" FontFamily="{StaticResource DisplayFont}" FontSize="14.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Strong}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SourceDot" Width="7" Height="7" Fill="{DynamicResource Danger}"
                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="SourceText" Text="Looking…" FontSize="11" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="StartLcButton" Content="Start" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="OnStartLiveCaptionsClick" />
                    </StackPanel>
                </DockPanel>

                <!-- One card per paragraph, filled by CaptionList; only changed cards are redrawn. -->
                <ScrollViewer x:Name="CaptionScroll" Grid.Row="1" Margin="16,0,6,0"
                              VerticalScrollBarVisibility="Auto" ScrollChanged="OnCaptionScrollChanged">
                    <StackPanel x:Name="CaptionStack" Margin="0,0,10,12" />
                </ScrollViewer>
                <StackPanel x:Name="CaptionEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="24" MaxWidth="260" IsHitTestVisible="False">
                    <Border Width="52" Height="52" CornerRadius="18" Background="{DynamicResource MintBg}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                   Foreground="{DynamicResource MintFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Listening…" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Strong}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="What the interviewer says shows up here, one card per pause."
                               Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <Button x:Name="JumpLatestButton" Grid.Row="1" Content="↓  Latest" Style="{StaticResource SmallButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,10"
                        Visibility="Collapsed" Click="OnJumpLatestClick"
                        ToolTip="Scroll to the newest captions and keep following them" />

                <!-- Full view: the waiting message with its actions, on a soft shadow (drawn by its own
                     border so the text stays crisp) -->
                <Border x:Name="NextPanelShadow" Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="18"
                        Margin="12,0,12,12" Effect="{StaticResource SoftShadow}" />
                <Border x:Name="NextPanel" Grid.Row="2" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18"
                        Margin="12,0,12,12" Padding="16,14">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="SendKeyChip" DockPanel.Dock="Right" Style="{StaticResource KeyChip}"
                                    VerticalAlignment="Center" ToolTip="Send hotkey">
                                <TextBlock x:Name="SendKeyText" />
                            </Border>
                            <Border Style="{StaticResource SmallIconChip}" Background="{DynamicResource SkyBg}">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource SmallChipGlyph}" Foreground="{DynamicResource SkyFg}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Next message" FontWeight="SemiBold" Foreground="{DynamicResource Strong}" />
                                <Run x:Name="PendingInfo" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                            </TextBlock>
                        </DockPanel>
                        <!-- Automatic mode only: fills up while the interviewer pauses -->
                        <ProgressBar x:Name="PauseProgress" Height="5" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                     Background="{DynamicResource Border}" Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                        <!-- The message to send: the waiting captions until you type in it, then your own
                             text. Fixed height (three lines, set with the font size): a box that grew with
                             every caption update made WPF lay out the whole caption column again each time. -->
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="DraftBox" Height="72" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" TextChanged="OnDraftChanged" PreviewKeyDown="OnDraftKeyDown"
                                     GotKeyboardFocus="OnDraftFocused" LostKeyboardFocus="OnDraftUnfocused"
                                     AutomationProperties.Name="Message to send"
                                     ToolTip="The interviewer's words appear here; type to edit them or write your own. Enter sends · Shift+Enter new line · Esc goes back to the interviewer's words" />
                            <!-- The waiting captions, drawn over the empty box until you click into it (see
                                 ShowCaptionDraft): text in a TextBox costs far too much to change on every update. -->
                            <ScrollViewer x:Name="DraftPreviewScroll" VerticalScrollBarVisibility="Hidden" Focusable="False"
                                          IsHitTestVisible="False" Margin="14,10,14,8">
                                <TextBlock x:Name="DraftPreview" TextWrapping="Wrap" FontSize="14" />
                            </ScrollViewer>
                        </Grid>
                        <DockPanel Margin="0,12,0,0" LastChildFill="False">
                            <Button x:Name="SendNowButton" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Send"
                                    Click="OnSendNowClick" Margin="0,0,6,0" Padding="18,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                               Margin="0,1,8,0" />
                                    <TextBlock Text="Send" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscardClick" Margin="0" />
                            <!-- What is already in the chat page's message box (chat page only) -->
                            <StackPanel x:Name="ChatBoxTools" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Chat box" FontSize="11" Foreground="{DynamicResource Faint}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button x:Name="SubmitChatButton" Content="Submit" Style="{StaticResource SmallButton}"
                                        Click="OnSubmitChatClick" />
                                <Button x:Name="ClearChatButton" Content="Clear" Style="{StaticResource SmallButton}" Margin="0"
                                        Click="OnClearChatClick" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Interview view: what is being heard and when it goes, with Send / Skip -->
                <Border x:Name="CompactBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,6,8,4">
                    <StackPanel>
                    <DockPanel>
                        <Button AutomationProperties.Name="Full view" x:Name="CompactFullButton" DockPanel.Dock="Right" Content="&#xE740;" Style="{StaticResource IconButton}" Margin="0"
                                Click="OnToggleCompactClick" ToolTip="Full view: the toolbar and the chat page" />
                        <Button AutomationProperties.Name="Menu" x:Name="CompactMenuButton" DockPanel.Dock="Right" Content="&#xE712;" Style="{StaticResource IconButton}"
                                Click="OnMainMenuClick" ToolTip="Menu: send, view, new chat, Settings (or right-click)" />
                        <Border x:Name="ViewSwitch" DockPanel.Dock="Right" Style="{StaticResource SegmentHost}"
                                Padding="2" CornerRadius="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                ToolTip="Show the clean answer, or the ChatGPT / DeepSeek page itself">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ViewAnswerTab" Content="Answer" GroupName="InterviewPane"
                                             Style="{StaticResource MiniTab}" Checked="OnInterviewPaneChecked" />
                                <RadioButton x:Name="ViewChatTab" Content="Chat page" GroupName="InterviewPane"
                                             Style="{StaticResource MiniTab}" Checked="OnInterviewPaneChecked" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ShowMessageBoxButton" DockPanel.Dock="Right" Content="&#xE70F;" Style="{StaticResource IconButton}"
                                FontSize="13" Visibility="Collapsed" Click="OnShowMessageBoxClick"
                                AutomationProperties.Name="Show the message box" ToolTip="Type a message (or edit the interviewer's words)" />
                        <!-- While the interviewer's words are waiting: send them now, or drop them -->
                        <StackPanel x:Name="WaitingActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="8,0,6,0" Visibility="Collapsed">
                            <Button x:Name="LiveSendButton" Content="Send" Style="{StaticResource PrimaryButton}" Padding="12,3" FontSize="12"
                                    Margin="0,0,4,0" Click="OnSendNowClick" AutomationProperties.Name="Send now"
                                    ToolTip="Send the interviewer's words now" />
                            <Button x:Name="LiveSkipButton" Content="Skip" Style="{StaticResource SmallButton}" Padding="10,3" FontSize="12"
                                    Margin="0" Click="OnDiscardClick" AutomationProperties.Name="Skip"
                                    ToolTip="Drop these words: not a question" />
                        </StackPanel>
                        <Ellipse x:Name="CompactDot" Width="7" Height="7" Fill="{DynamicResource Danger}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border x:Name="CompactKeyChip" DockPanel.Dock="Right" Style="{StaticResource KeyChip}"
                                Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Send hotkey">
                            <TextBlock x:Name="CompactKeyText" />
                        </Border>
                        <TextBlock x:Name="CompactInfo" FontSize="12" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <!-- Automatic sending: fills up while the interviewer pauses, then the words go -->
                    <ProgressBar x:Name="CompactPauseProgress" Height="3" Margin="0,5,0,0" Minimum="0" Maximum="1"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" Visibility="Hidden" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="ColumnSplitter" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"
                          DragCompleted="OnSplitterDragCompleted" ToolTip="Drag to resize the captions" />

            <!-- Chat page, and in interview view the answer reader in its place. The chat page keeps
                 running (shrunk to a pixel) because messages are typed into it and answers read from it. -->
            <Grid x:Name="ChatHost">
                <Border x:Name="ReaderPanel" Background="{DynamicResource WindowBg}" Visibility="Collapsed"
                        MouseEnter="OnReaderMouseEnter" MouseLeave="OnReaderMouseLeave">
                    <DockPanel>
                        <!-- One slim bar, so the answer starts near the top of the window (near the camera):
                             what is happening, the round and the question's kind, earlier answers. Copy,
                             Listen and text size appear only while the mouse is over the answer. -->
                        <Border x:Name="ReaderHeader" DockPanel.Dock="Top" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,5,8,5">
                            <DockPanel>
                                <StackPanel x:Name="HistoryNav" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Button x:Name="HistoryPrev" Content="&#xE76B;" Style="{StaticResource IconButton}" Width="26" Height="24"
                                            FontSize="11" Margin="0" Click="OnHistoryPrevClick"
                                            AutomationProperties.Name="Previous answer" ToolTip="Previous answer" />
                                    <TextBlock x:Name="HistoryText" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                    <Button x:Name="HistoryNext" Content="&#xE76C;" Style="{StaticResource IconButton}" Width="26" Height="24"
                                            FontSize="11" Margin="0" Click="OnHistoryNextClick"
                                            AutomationProperties.Name="Next answer" ToolTip="Next answer" />
                                </StackPanel>
                                <StackPanel x:Name="ReaderHoverTools" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="8,0,4,0" Visibility="Collapsed">
                                    <!-- Copy: the selected text, or else the whole answer (label kept for the Copied state) -->
                                    <Button x:Name="CopyButton" AutomationProperties.Name="Copy answer" Style="{StaticResource IconButton}"
                                            Width="28" Height="26" Click="OnCopyAnswerClick" ToolTip="Copy the answer, or the selected text">
                                        <Grid>
                                            <TextBlock x:Name="CopyGlyph" Text="&#xE8C8;" FontSize="13" Foreground="{DynamicResource Accent}" />
                                            <TextBlock x:Name="CopyText" Text="Copy" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <!-- Listen / Stop, like Google Translate's speaker button (glyph and tooltip set in code) -->
                                    <Button x:Name="ListenButton" AutomationProperties.Name="Listen" Style="{StaticResource IconButton}"
                                            Width="28" Height="26" Click="OnListenClick">
                                        <Grid>
                                            <TextBlock x:Name="ListenGlyph" Text="&#xE767;" FontSize="13" Foreground="{DynamicResource Accent}" />
                                            <TextBlock x:Name="ListenText" Text="Listen" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button AutomationProperties.Name="Smaller answer text" Content="A−" Style="{StaticResource IconButton}" Width="28" Height="26" FontFamily="{StaticResource UiFont}" FontSize="12.5" Click="OnAnswerFontSmaller" ToolTip="Smaller answer text" />
                                    <Button AutomationProperties.Name="Larger answer text" Content="A+" Style="{StaticResource IconButton}" Width="28" Height="26" FontFamily="{StaticResource UiFont}" FontSize="12.5" Margin="0" Click="OnAnswerFontLarger" ToolTip="Larger answer text" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Pill}" Padding="8,2" VerticalAlignment="Center" Margin="0,0,6,0"
                                            ToolTip="What is happening: listening, thinking, writing, reading aloud, or ready">
                                        <TextBlock x:Name="AnswerState" Text="Waiting" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}" />
                                    </Border>
                                    <Border x:Name="QuestionTypeChip" Style="{StaticResource Pill}" Padding="7,1" Margin="0,0,6,0"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            ToolTip="The kind of question this answer is for; the answer's format follows it">
                                        <TextBlock x:Name="QuestionTypeText" FontSize="11" Foreground="{DynamicResource Accent}" />
                                    </Border>
                                    <!-- Shown while the mouse is over the answer -->
                                    <Button x:Name="InterviewTypeButton" Style="{StaticResource SmallButton}" Padding="8,1" Click="OnInterviewTypeClick"
                                            AutomationProperties.Name="Interview round" Visibility="Collapsed"
                                            ToolTip="The kind of interview round: it sets what the answers focus on">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="InterviewTypeText" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Moving bar while the AI is thinking or writing (brush animated in code) -->
                        <Border x:Name="LoadingBar" DockPanel.Dock="Top" Height="3" Visibility="Hidden" />
                        <!-- The question this answer is for: its end (where the question is), two lines at most -->
                        <DockPanel x:Name="QuestionRow" DockPanel.Dock="Top" Margin="16,8,16,0" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Left" Text="Q" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                       Margin="0,1,8,0" />
                            <TextBlock x:Name="QuestionText" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="38" LineHeight="18" />
                        </DockPanel>
                        <!-- Interview view: the message box, opened with the pencil to type your own message
                             (the same text as in full view); it takes room from the answer, not the captions -->
                        <DockPanel x:Name="CompactComposer" DockPanel.Dock="Bottom" Margin="12,4,10,10" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButton}" FontSize="11"
                                    Width="26" Height="26" Margin="4,0,0,2" VerticalAlignment="Bottom" Click="OnHideMessageBoxClick"
                                    AutomationProperties.Name="Hide the message box"
                                    ToolTip="Close the message box (the Send hotkey still sends the interviewer's words)" />
                            <Button x:Name="CompactSendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"
                                    Padding="12,4" VerticalAlignment="Bottom" Click="OnSendNowClick" AutomationProperties.Name="Send message">
                                <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                            </Button>
                            <Grid>
                                <TextBox x:Name="CompactDraftBox" Height="48" FontSize="13" Padding="10,5" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnDraftChanged"
                                         PreviewKeyDown="OnDraftKeyDown" GotKeyboardFocus="OnDraftFocused" LostKeyboardFocus="OnDraftUnfocused"
                                         AutomationProperties.Name="Message to send (interview view)"
                                         ToolTip="Enter sends · Shift+Enter new line · Esc goes back to the interviewer's words" />
                                <ScrollViewer x:Name="CompactDraftPreviewScroll" VerticalScrollBarVisibility="Hidden" Focusable="False"
                                              IsHitTestVisible="False" Margin="12,6,12,4">
                                    <TextBlock x:Name="CompactDraftPreview" TextWrapping="Wrap" FontSize="13" />
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                        <!-- Under the answer, when it has details: unfold them -->
                        <Button x:Name="DetailToggle" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Style="{StaticResource SmallButton}"
                                Padding="12,5" FontSize="12.5" Margin="12,6,12,6" Click="OnDetailToggleClick"
                                Visibility="Collapsed" ToolTip="The full story, design or code behind the talking points">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DetailToggleGlyph" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{DynamicResource Accent}" />
                                <TextBlock x:Name="DetailToggleText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <!-- The selection stays visible while another app is in front, so the Listen
                                 hotkey can read it from there. -->
                            <RichTextBox x:Name="AnswerBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}"
                                         Padding="14,14,8,20" VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource UiFont}" SelectionBrush="{DynamicResource Accent}"
                                         IsInactiveSelectionHighlightEnabled="True"
                                         PreviewMouseLeftButtonUp="OnAnswerMouseUp" SelectionChanged="OnAnswerSelectionChanged"
                                         LostKeyboardFocus="OnAnswerLostFocus" ScrollViewer.ScrollChanged="OnAnswerScrolled">
                                <FlowDocument PagePadding="0" />
                            </RichTextBox>
                            <!-- Only when the answer goes on below the window: scrolls down to the rest -->
                            <Button x:Name="AnswerMoreButton" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                    Style="{StaticResource SmallButton}" Padding="14,4" FontSize="12" Visibility="Collapsed"
                                    Click="OnAnswerMoreClick" AutomationProperties.Name="More of the answer"
                                    ToolTip="The answer continues below">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="More" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="7,1,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </Button>
                            <!-- Small Listen button next to the mouse after text is selected (as on Google Translate) -->
                            <Popup x:Name="SelectionPopup" PlacementTarget="{Binding ElementName=AnswerBox}" Placement="Relative"
                                   AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SelectionListenButton" Style="{StaticResource PrimaryButton}" Focusable="False"
                                            Padding="12,4" FontSize="12" Margin="0,0,4,0" Click="OnSelectionListenClick"
                                            AutomationProperties.Name="Listen to the selection">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SelectionListenGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" />
                                            <TextBlock x:Name="SelectionListenText" Text="Listen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SelectionCopyButton" Style="{StaticResource SmallButton}" Focusable="False"
                                            Padding="11,3" FontSize="12" Margin="0" Click="OnCopyAnswerClick"
                                            AutomationProperties.Name="Copy the selection">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SelectionCopyGlyph" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" Foreground="{DynamicResource Accent}" />
                                            <TextBlock x:Name="SelectionCopyText" Text="Copy" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Popup>
                            <StackPanel x:Name="ReaderEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28"
                                        MaxWidth="380" IsHitTestVisible="False">
                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource HoverBg}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="19"
                                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Waiting for the first question" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Strong}" HorizontalAlignment="Center"
                                           Margin="0,12,0,6" />
                                <TextBlock x:Name="ReaderEmpty" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
                            </StackPanel>

                            <!-- Start interview: the job, the round, where answers come from and a ready check, then one button -->
                            <ScrollViewer x:Name="SessionCard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Visibility="Collapsed">
                                <ContentControl Style="{StaticResource Card}" MaxWidth="560" Margin="16,20" Padding="24,20,24,22"
                                                VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="Start your interview" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Strong}" />
                                        <TextBlock Text="Check these, then press Start. Each question is answered as the interviewer asks it."
                                                   Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,18" />

                                        <TextBlock Text="JOB" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Content="From JobStrike" Style="{StaticResource SmallButton}" Padding="10,4"
                                                            Click="OnSessionJobStrikeClick"
                                                            ToolTip="Load the company, job description and resume of one of your JobStrike applications" />
                                                    <Button Content="Edit" Style="{StaticResource SmallButton}" Padding="10,4" Margin="0"
                                                            Click="OnSessionEditDetailsClick" ToolTip="Your profile, the job description and your resume" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="SessionJobText" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Strong}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SessionJobDetail" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <TextBlock Text="ROUND" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                                        <WrapPanel x:Name="SessionRounds" Margin="0,0,0,-6" />

                                        <TextBlock Text="ANSWERS FROM" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                                        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Change" Style="{StaticResource SmallButton}" Padding="10,4"
                                                        Margin="10,0,0,0" VerticalAlignment="Center" Click="OnSessionChangeEngineClick"
                                                        ToolTip="Settings ▸ Answers: the chat page, or an AI API and its key" />
                                                <TextBlock x:Name="SessionEngineGlyph" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}"
                                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="SessionEngineText" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Strong}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SessionEngineDetail" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <TextBlock Text="READY CHECK" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                                        <StackPanel x:Name="SessionChecks" />

                                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,12,0,12" />
                                        <CheckBox x:Name="SessionAutoSend" Style="{StaticResource ToggleSwitch}" IsChecked="True">
                                            <StackPanel>
                                                <TextBlock Text="Send questions automatically" FontWeight="SemiBold" />
                                                <TextBlock Text="When the interviewer pauses after speaking." FontSize="11.5"
                                                           Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SessionSpeak" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"
                                                  Click="OnSessionSpeakClick">
                                            <StackPanel>
                                                <TextBlock Text="Read answers aloud" FontWeight="SemiBold" />
                                                <TextBlock Text="Into your headphones, as each answer arrives." FontSize="11.5"
                                                           Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>

                                        <Button x:Name="SessionStartButton" Style="{StaticResource PrimaryButton}" Padding="0,11" Margin="0,20,0,0"
                                                FontSize="14" Click="OnSessionStartClick" AutomationProperties.Name="Start interview">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           VerticalAlignment="Center" Margin="0,1,10,0" />
                                                <TextBlock Text="Start interview" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="SessionHint" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                                    </StackPanel>
                                </ContentControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
                <wv2:WebView2 x:Name="ChatGptView" />
                <wv2:WebView2 x:Name="DeepSeekView" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
