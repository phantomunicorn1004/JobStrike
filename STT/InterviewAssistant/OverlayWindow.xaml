<Window x:Class="InterviewAssistant.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview Assistant · Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False" MinWidth="320" MinHeight="220"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">
    <!-- Borderless and see-through: WindowChrome keeps dragging (top bar) and resizing (edges). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" CornerRadius="18" BorderThickness="1">
        <DockPanel x:Name="Body">
            <Grid DockPanel.Dock="Top" Height="38" Margin="14,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Drag here to move · drag the edges to resize">
                    <Image Source="/Assets/AppIcon.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Interview Assistant" FontSize="11.5" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="8,0,0,0"
                             VerticalAlignment="Center" ToolTip="Green: Live Captions connected" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="See-through" FontSize="11" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="OpacitySlider" Width="90" Minimum="0" Maximum="0.85" SmallChange="0.05"
                            LargeChange="0.1" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Drag right to see more of the window behind (the text stays solid)" />
                    <TextBlock x:Name="OpacityLabel" Width="36" FontSize="11" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0" />
                    <Button AutomationProperties.Name="Menu" x:Name="MenuButton" Content="&#xE712;" Style="{StaticResource IconButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Menu: send, see-through, text size, new chat, Settings" />
                    <Button AutomationProperties.Name="Full view" x:Name="ExitButton" Content="&#xE740;" Style="{StaticResource IconButton}" Margin="0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Full view: leave the overlay and open the full window" />
                </StackPanel>
            </Grid>

            <!-- Caption strip and answer reader are moved in here from the main window. -->
            <Grid x:Name="ContentHost" Margin="1,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CaptionRow" Height="120" MinHeight="40" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="CaptionSlot" Focusable="False" />
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext" Background="Transparent"
                              ToolTip="Drag to show more or fewer caption lines" />
                <Border Grid.Row="1" Height="1" Margin="14,0" Background="{DynamicResource Border}"
                        IsHitTestVisible="False" />
                <ContentControl x:Name="ReaderSlot" Grid.Row="2" Focusable="False" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
