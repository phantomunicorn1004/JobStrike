<Window x:Class="InterviewAssistant.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="820" Width="1000" MinWidth="760" MinHeight="520"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Strong}" />
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,10" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Strong}" />
        </Style>
        <Style x:Key="ChoiceText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="MultiLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="HotkeyLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4,24,4" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="24,4,24,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Padding="16,7" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="False" Margin="0"
                            Click="OnSaveClick" Padding="26,7" />
                </StackPanel>
                <TextBlock Text="Saved on this PC only." Foreground="{DynamicResource Faint}" FontSize="11.5"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Navigation rail, as in Windows Settings -->
        <Border DockPanel.Dock="Left" Width="216" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0" Padding="12,18,12,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,20">
                    <Image Source="/Assets/AppIcon.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource Strong}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <RadioButton x:Name="TabInterview" Background="{DynamicResource LilacBg}" BorderBrush="{DynamicResource LilacFg}"
                             Content="Interview" Tag="&#xE77B;" GroupName="Tabs" IsChecked="True"
                             Style="{StaticResource NavItem}" Checked="OnTabChecked" />
                <RadioButton x:Name="TabAnswers" Background="{DynamicResource LilacBg}" BorderBrush="{DynamicResource LilacFg}"
                             Content="Answers" Tag="&#xE8BD;" GroupName="Tabs"
                             Style="{StaticResource NavItem}" Checked="OnTabChecked" />
                <RadioButton x:Name="TabSending" Background="{DynamicResource MintBg}" BorderBrush="{DynamicResource MintFg}"
                             Content="Sending" Tag="&#xE724;" GroupName="Tabs"
                             Style="{StaticResource NavItem}" Checked="OnTabChecked" />
                <RadioButton x:Name="TabDisplay" Background="{DynamicResource PeachBg}" BorderBrush="{DynamicResource PeachFg}"
                             Content="Display" Tag="&#xE7F4;" GroupName="Tabs"
                             Style="{StaticResource NavItem}" Checked="OnTabChecked" />
                <RadioButton x:Name="TabVoice" Background="{DynamicResource SunBg}" BorderBrush="{DynamicResource SunFg}"
                             Content="Voice" Tag="&#xE767;" GroupName="Tabs"
                             Style="{StaticResource NavItem}" Checked="OnTabChecked" />
                <RadioButton x:Name="TabHotkeys" Background="{DynamicResource SkyBg}" BorderBrush="{DynamicResource SkyFg}"
                             Content="Hotkeys" Tag="&#xE765;" GroupName="Tabs"
                             Style="{StaticResource NavItem}" Checked="OnTabChecked" />
            </StackPanel>
        </Border>

        <!-- The chosen page, with its title -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
                <TextBlock x:Name="PageTitle" Text="Interview" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                           FontWeight="SemiBold" Foreground="{DynamicResource Strong}" />
                <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- INTERVIEW: what the AI should know -->
                <StackPanel x:Name="PageInterview" Style="{StaticResource Page}">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Load from JobStrike…" VerticalAlignment="Top"
                                        Click="OnLoadFromJobStrikeClick"
                                        ToolTip="Fill the company, job description and resume from one of your JobStrike applications" />
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource LilacBg}">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource LilacFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="About you and the role" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Sent to the AI at the start of each chat (New chat + call prompt)."
                                               Style="{StaticResource CardSubtitle}" />
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="JobStrikeNote" Visibility="Collapsed" Margin="0,2,0,4" Padding="14,10" CornerRadius="14"
                                    Background="{DynamicResource PendingBg}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                <TextBlock x:Name="JobStrikeNoteText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text}" />
                            </Border>

                            <TextBlock Text="My profile" Style="{StaticResource Label}" Margin="0,4,0,6" />
                            <TextBox x:Name="ProfileBox" Style="{StaticResource MultiLine}" Height="100" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Name, current title, years of experience, core skills, things you want to highlight." />

                            <TextBlock Text="Client company" Style="{StaticResource Label}" />
                            <TextBox x:Name="CompanyBox" Style="{StaticResource MultiLine}" Height="56" />

                            <TextBlock Text="Job description" Style="{StaticResource Label}" />
                            <TextBox x:Name="JobDescriptionBox" Style="{StaticResource MultiLine}" Height="150" />

                            <DockPanel Margin="0,12,0,6">
                                <Button DockPanel.Dock="Right" Content="Load resume (PDF / Word)…" Style="{StaticResource SmallButton}"
                                        Margin="0" Padding="10,3" Click="OnLoadResumeClick" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="My resume" FontWeight="SemiBold" FontSize="12.5" />
                                    <Run Text="  optional" Foreground="{DynamicResource Faint}" FontSize="11.5" />
                                </TextBlock>
                            </DockPanel>
                            <TextBox x:Name="ResumeBox" Style="{StaticResource MultiLine}" Height="150" AllowDrop="True"
                                     PreviewDragOver="OnResumeDragOver" PreviewDrop="OnResumeDrop" />
                            <TextBlock x:Name="ResumeHint" Style="{StaticResource Hint}"
                                       Text="Paste the text, click Load, or drop a .pdf, .docx, .txt or .md file here. You can edit the extracted text." />
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Reset to default" Style="{StaticResource SmallButton}"
                                        Margin="0" Padding="10,3" Click="OnResetPromptClick" VerticalAlignment="Top" />
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource SkyBg}">
                                    <TextBlock Text="&#xE8BD;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource SkyFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Call prompt" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="The instructions sent with your details. The default works well; edit it only if you want different answers. {profile} {company} {job_description} {resume} are filled in for you." />
                                </StackPanel>
                            </DockPanel>
                            <TextBox x:Name="CallPromptBox" Style="{StaticResource MultiLine}" Height="220"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!-- SENDING: one choice for what the Send key does -->
                <StackPanel x:Name="PageSending" Style="{StaticResource Page}" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource MintBg}">
                                    <TextBlock Text="&#xE724;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource MintFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="When you press Send" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="Send takes what the interviewer just said (the highlighted captions) and gives it to the AI." />
                                </StackPanel>
                            </DockPanel>

                            <RadioButton x:Name="SendModeManual" GroupName="SendMode" Style="{StaticResource ChoiceCard}"
                                         Checked="OnSendModeChecked">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ChoiceTitle}">
                                        <Run Text="Put it in the chat box, then you press Enter" />
                                        <Run Text="  recommended" Foreground="{DynamicResource Accent}" FontWeight="Normal" FontSize="11.5" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="Check or fix the text first, then submit with Enter in the chat or the Submit hotkey." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SendModeSubmit" GroupName="SendMode" Style="{StaticResource ChoiceCard}"
                                         Checked="OnSendModeChecked">
                                <StackPanel>
                                    <TextBlock Text="Send it to the AI right away" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="One key press: the question goes to the AI immediately." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SendModeAuto" GroupName="SendMode" Style="{StaticResource ChoiceCard}"
                                         Checked="OnSendModeChecked">
                                <StackPanel>
                                    <TextBlock Text="Automatic" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="No key press: the question is sent as soon as the interviewer pauses." />
                                    <StackPanel x:Name="AutoOptions" Margin="0,10,0,0" Visibility="Collapsed">
                                        <WrapPanel>
                                            <TextBlock Text="Send after a pause of" VerticalAlignment="Center" />
                                            <TextBox x:Name="PauseBox" Width="60" Margin="10,0" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="seconds, once there are at least" VerticalAlignment="Center" />
                                            <TextBox x:Name="MinWordsBox" Width="52" Margin="10,0" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="words." VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="1.5–2.5 s suits most interviewers. Shorter answers faster but may split a question in two; the word minimum keeps “okay” or “great” from being sent alone." />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!-- DISPLAY -->
                <StackPanel x:Name="PageDisplay" Style="{StaticResource Page}" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource PeachBg}">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource PeachFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Interview view" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="The small window you use during the interview: live captions and the AI answer." />
                                </StackPanel>
                            </DockPanel>
                            <RadioButton x:Name="StyleOverlay" GroupName="ViewStyle" Style="{StaticResource ChoiceCard}"
                                         Checked="OnViewStyleChecked">
                                <StackPanel>
                                    <TextBlock Text="See-through overlay" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="Floats above every window. Place it over the meeting and set how see-through it is with the slider in its top bar; the text stays solid." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="StyleWindow" GroupName="ViewStyle" Style="{StaticResource ChoiceCard}"
                                         Checked="OnViewStyleChecked">
                                <StackPanel>
                                    <TextBlock Text="Normal window" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="A small regular window you can move and resize." />
                                    <StackPanel x:Name="DockOptions" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Captions" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" />
                                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="DockTop" Content="Above" GroupName="Dock" Style="{StaticResource ProviderTab}" />
                                                <RadioButton x:Name="DockBottom" Content="Below" GroupName="Dock" Style="{StaticResource ProviderTab}" />
                                                <RadioButton x:Name="DockLeft" Content="Left" GroupName="Dock" Style="{StaticResource ProviderTab}" />
                                                <RadioButton x:Name="DockRight" Content="Right" GroupName="Dock" Style="{StaticResource ProviderTab}" />
                                                <RadioButton x:Name="DockFloating" Content="Own window" GroupName="Dock" Style="{StaticResource ProviderTab}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource SunBg}">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource SunFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="Dark is easiest on the eyes in a dim room; light reads faster in a bright one." />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource ProviderTab}" />
                                    <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource ProviderTab}" />
                                    <RadioButton x:Name="ThemeSystem" Content="Match Windows" GroupName="Theme" Style="{StaticResource ProviderTab}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource SkyBg}">
                                    <TextBlock Text="&#xE737;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource SkyFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Window" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Staying on top, and the Windows Live Captions window." />
                                </StackPanel>
                            </DockPanel>
                            <CheckBox x:Name="TopmostToggle" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Keep the full window above other windows" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Text="The overlay always stays on top." Style="{StaticResource ChoiceText}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="HideLcToggle" Style="{StaticResource ToggleSwitch}">
                                <StackPanel>
                                    <TextBlock Text="Hide the Windows Live Captions window" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Text="Moves it off-screen; it keeps captioning. It comes back when you turn this off or close the app."
                                               Style="{StaticResource ChoiceText}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!-- ANSWERS: where they come from, and how they fit the interview round -->
                <StackPanel x:Name="PageAnswers" Style="{StaticResource Page}" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource LilacBg}">
                                    <TextBlock Text="&#xE8BD;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource LilacFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Where answers come from" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="An AI API answers in about a second and needs no chat page; the chat page uses your own ChatGPT or DeepSeek account." />
                                </StackPanel>
                            </DockPanel>
                            <RadioButton x:Name="EngineChatPage" GroupName="Engine" Style="{StaticResource ChoiceCard}" Checked="OnEngineChecked">
                                <StackPanel>
                                    <TextBlock Text="ChatGPT or DeepSeek page" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="Your account in the app's browser. No key needed; the call prompt is typed into a new chat, and answers take a few seconds." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="EngineOpenAi" GroupName="Engine" Style="{StaticResource ChoiceCard}" Checked="OnEngineChecked">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ChoiceTitle}">
                                        <Run Text="OpenAI API" />
                                        <Run Text="  fastest" Foreground="{DynamicResource Accent}" FontWeight="Normal" FontSize="11.5" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="Answers start in about a second. Needs an OpenAI API key; billed per use (a few cents per interview with a mini model)." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="EngineDeepSeek" GroupName="Engine" Style="{StaticResource ChoiceCard}" Checked="OnEngineChecked">
                                <StackPanel>
                                    <TextBlock Text="DeepSeek API" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="Fast and inexpensive. Needs a DeepSeek API key (platform.deepseek.com)." />
                                </StackPanel>
                            </RadioButton>

                            <StackPanel x:Name="ApiPanel" Visibility="Collapsed">
                                <TextBlock x:Name="ApiKeyLabel" Text="API key" Style="{StaticResource Label}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Check key" Margin="10,0,0,0" Padding="16,6"
                                            Click="OnCheckApiKeyClick" ToolTip="Check the key and load the models it can use" />
                                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyChanged" AutomationProperties.Name="API key" />
                                </DockPanel>
                                <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Hint}" />
                                <TextBlock Text="Model" Style="{StaticResource Label}" />
                                <ComboBox x:Name="ApiModelBox" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Listed from your key, quick ones first: a mini or chat model answers fastest and costs least, which suits a live interview. The key is stored encrypted for your Windows account." />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource SkyBg}">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource SkyFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Interview round" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="Sets what the answers focus on. Each question is also recognized (behavioral, technical, system design, coding, logistics…) and answered in the matching format; the kind is shown above the answer." />
                                </StackPanel>
                            </DockPanel>
                            <ComboBox x:Name="InterviewTypeBox" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Also on the button above the answer during the call. With an API it applies to the next answer; with the chat page, from the next New chat + call prompt." />
                            <TextBlock Text="Answer length" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LengthShort" Content="Short" GroupName="Length" Style="{StaticResource ProviderTab}" />
                                    <RadioButton x:Name="LengthNormal" Content="Normal" GroupName="Length" Style="{StaticResource ProviderTab}" />
                                    <RadioButton x:Name="LengthDetailed" Content="Detailed" GroupName="Length" Style="{StaticResource ProviderTab}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!-- VOICE: reading the answer aloud -->
                <StackPanel x:Name="PageVoice" Style="{StaticResource Page}" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource SunBg}">
                                    <TextBlock Text="&#xE767;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource SunFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Read answers aloud" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="Each new answer is read out, starting with the first sentence while the rest is still being written. Use headphones so the interviewer does not hear it." />
                                </StackPanel>
                            </DockPanel>
                            <CheckBox x:Name="SpeakToggle" Style="{StaticResource ToggleSwitch}" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Also read new answers automatically" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="Off: nothing is read until you press Listen above the answer (or the Listen hotkey), as on Google Translate. Press it again while it speaks to stop; again after it ends to hear it slower." />
                                </StackPanel>
                            </CheckBox>

                            <TextBlock Text="Voice service" Style="{StaticResource Label}" Margin="0,18,0,6" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ServiceGoogle" Content="Google (natural)" GroupName="VoiceService"
                                                 Style="{StaticResource ProviderTab}" Checked="OnVoiceServiceChecked" />
                                    <RadioButton x:Name="ServiceWindows" Content="Windows (offline)" GroupName="VoiceService"
                                                 Style="{StaticResource ProviderTab}" Checked="OnVoiceServiceChecked" />
                                </StackPanel>
                            </Border>

                            <!-- Google Cloud Text-to-Speech: the voices behind Google Translate's Listen -->
                            <StackPanel x:Name="GooglePanel">
                                <TextBlock Text="Google API key" Style="{StaticResource Label}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Check key" Margin="10,0,0,0" Padding="16,6"
                                            Click="OnCheckGoogleKeyClick" ToolTip="Check the key with Google and load its voices" />
                                    <PasswordBox x:Name="GoogleKeyBox" PasswordChanged="OnGoogleKeyChanged" />
                                </DockPanel>
                                <TextBlock x:Name="GoogleKeyStatus" Style="{StaticResource Hint}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                    <Run Text="One-time setup, about 5 minutes:" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="1. Open Google Cloud, sign in, create a project and enable the Cloud Text-to-Speech API (Google asks for a billing account; about 1 million characters a month are free, many interviews' worth)." />
                                    <LineBreak />
                                    <Run Text="2. APIs &amp; Services ▸ Credentials ▸ Create credentials ▸ API key. Restrict it to the Cloud Text-to-Speech API." />
                                    <LineBreak />
                                    <Run Text="3. Paste the key above and press Check key." />
                                </TextBlock>
                                <Button Content="Open Google Cloud" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,4"
                                        Style="{StaticResource SmallButton}" Click="OnOpenGoogleCloudClick" />
                            </StackPanel>

                            <TextBlock Text="Voice" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Click="OnTestVoiceClick" Padding="16,6" AutomationProperties.Name="Test voice"
                                        ToolTip="Hear the voice at this speed on this output">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="Test" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Grid>
                                    <ComboBox x:Name="GoogleVoiceBox" />
                                    <ComboBox x:Name="VoiceBox" Visibility="Collapsed" />
                                </Grid>
                            </DockPanel>

                            <TextBlock Text="Speed" Style="{StaticResource Label}" />
                            <DockPanel>
                                <TextBlock x:Name="RateLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Slider x:Name="RateSlider" Minimum="0.6" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnRateChanged" />
                            </DockPanel>

                            <TextBlock Text="Play on" Style="{StaticResource Label}" />
                            <ComboBox x:Name="DeviceBox" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Live Captions listens to the default speaker. Playing the voice on another output (for example a second headset) keeps it out of the captions." />

                            <CheckBox x:Name="SkipCaptionsToggle" Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ignore captions while the voice speaks" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="On the default speaker Live Captions writes down the voice too; without this its words would be sent back to the AI as the interviewer's. Pressing Send while it speaks stops the voice." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!-- HOTKEYS -->
                <StackPanel x:Name="PageHotkeys" Style="{StaticResource Page}" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconChip}" Background="{DynamicResource SkyBg}">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource ChipGlyph}" Foreground="{DynamicResource SkyFg}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}"
                                               Text="Click a box and press the combination: Ctrl, Alt or Win with a key, or a function key on its own. Backspace removes one." />
                                </StackPanel>
                            </DockPanel>
                            <Grid x:Name="HotkeyGrid" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Send" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeySendBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource HotkeyBox}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Discard" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyDiscardBox" Grid.Row="0" Grid.Column="3" Style="{StaticResource HotkeyBox}" Margin="0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Submit (Enter)" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeySubmitBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource HotkeyBox}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Clear chat box" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyClearBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource HotkeyBox}" Margin="0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scroll answer down" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyScrollDownBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource HotkeyBox}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Scroll answer up" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyScrollUpBox" Grid.Row="2" Grid.Column="3" Style="{StaticResource HotkeyBox}" Margin="0,4" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Interview / full view" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyCompactBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource HotkeyBox}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Automatic on / off" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyAutoBox" Grid.Row="3" Grid.Column="3" Style="{StaticResource HotkeyBox}" Margin="0,4" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Overlay more solid" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyLessSeeThroughBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource HotkeyBox}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Overlay more see-through" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyMoreSeeThroughBox" Grid.Row="4" Grid.Column="3" Style="{StaticResource HotkeyBox}" Margin="0,4" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Automatic reading on / off" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyVoiceBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource HotkeyBox}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Listen / stop" Style="{StaticResource HotkeyLabel}" />
                                <TextBox x:Name="HotkeyStopVoiceBox" Grid.Row="5" Grid.Column="3" Style="{StaticResource HotkeyBox}" Margin="0,4" />
                            </Grid>
                            <!-- Everyday shortcuts used as hotkeys work only in the meeting (and this app) -->
                            <TextBlock Text="Everyday shortcuts as hotkeys" Style="{StaticResource Label}" Margin="0,18,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="A hotkey that other programs also use (Ctrl+X, Ctrl+Space, Ctrl+= …) works as a hotkey only while Interview Assistant or one of these apps is in front. Everywhere else it keeps its normal job, so Ctrl+X still cuts in your editor and browser." />
                            <TextBox x:Name="HotkeyAppsBox" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Words separated by commas, matched against the app's name and its window title: a Chrome tab with Google Meet open counts as Meet." />
                            <CheckBox x:Name="HotkeysEverywhereToggle" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      Checked="OnHotkeyScopeChanged" Unchecked="OnHotkeyScopeChanged">
                                <StackPanel>
                                    <TextBlock Text="Use them everywhere instead" Style="{StaticResource ChoiceTitle}" />
                                    <TextBlock Style="{StaticResource ChoiceText}"
                                               Text="They then stop doing their normal job in every other program while Interview Assistant runs." />
                                </StackPanel>
                            </CheckBox>
                            <!-- Shown when a chosen combination is a common shortcut in other programs -->
                            <Border x:Name="HotkeyWarning" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10"
                                    CornerRadius="14" Background="{DynamicResource PendingBg}"
                                    BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                <TextBlock x:Name="HotkeyWarningText" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                           Foreground="{DynamicResource Text}" />
                            </Border>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
