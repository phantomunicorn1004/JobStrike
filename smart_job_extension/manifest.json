{
  "manifest_version": 3,
  "name": "Remote Helper",
  "version": "4.5.0",
  "description": "Autofill job applications with Remote Helper — saved profile, custom Q&A, and Resume DB registration.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Remote Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "refresh-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Scrape current job and add it to saved jobs"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["field-registry.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
